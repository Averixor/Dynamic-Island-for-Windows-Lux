# https://editorconfig.org — Prettier and VS Code/Cursor read this.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bat,cmd,iss}]
end_of_line = crlf
indent_size = 4

[*.{cpp,h,c,hpp}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = true
trim_trailing_whitespace = false
