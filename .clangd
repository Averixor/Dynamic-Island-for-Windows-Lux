# Indexing flags for app/island.cpp and other TUs.
# Force C++20 coroutine feature macro so C++/WinRT does not include MSVC's
# <experimental/coroutine>, which #errors under Clang. MSVC build stays C++17.
CompileFlags:
  Add:
    - --target=x86_64-pc-windows-msvc
    - -std=c++20
    - -fms-compatibility
    - -fms-extensions
    - -DUNICODE
    - -D_UNICODE
    - -DNOMINMAX
    - -DWIN32_LEAN_AND_MEAN
    - -D_CRT_SECURE_NO_WARNINGS
    - -D_SILENCE_EXPERIMENTAL_COROUTINE_DEPRECATION_WARNINGS
    - -D__cpp_lib_coroutine=201902L
    - -Iapp
    - -I.clangd-support

Diagnostics:
  Suppress:
    - unused-includes
    - "-Wunused-*"

---
# Extensionless STL-style shims (e.g. experimental/coroutine) produce
# fe_expected_compiler_job unless the driver language is set explicitly.
If:
  PathMatch: .*clangd-support.*
CompileFlags:
  Add:
    - -xc++-header
