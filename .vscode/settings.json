{
  "cSpell.import": ["${workspaceFolder}/cspell.json"],
  "cSpell.language": "en,uk,ru",
  "cSpell.allowCompoundWords": true,
  "files.associations": {
    "*.rc.in": "rc",
    "*.manifest.in": "xml",
    "*.iss": "innosetup",
    "LICENSE": "plaintext"
  },
  "markdownlint.configFile": ".markdownlint-cli2.jsonc",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.md",
    "!LICENSE",
    "!**/LICENSE",
    "!INSTALL.txt",
    "!**/*.iss",
    "!**/*.gen.rc",
    "!installer/**",
    "!dist/**",
    "!build/**",
    "!dictionaries/**",
    "!**/node_modules/**"
  ],
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[bat]": {
    "files.eol": "\r\n"
  },
  "[cmd]": {
    "files.eol": "\r\n"
  },
  "editor.formatOnSave": false
}
