{
  "cSpell.import": ["${workspaceFolder}/cspell.json"],
  "cSpell.language": "en,uk,ru",
  "cSpell.allowCompoundWords": true,
  "files.associations": {
    "*.h": "cpp",
    "*.rc.in": "rc",
    "*.manifest.in": "xml",
    "*.iss": "innosetup",
    "CMakeLists.txt": "cmake",
    "*.cmake": "cmake",
    ".clang-format": "yaml",
    "LICENSE": "plaintext",
    "INSTALL.txt": "plaintext",
    "**/.clangd-support/**": "cpp"
  },
  "markdownlint.configFile": ".markdownlint-cli2.jsonc",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.md",
    "!LICENSE",
    "!**/LICENSE",
    "!INSTALL.txt",
    "!**/*.iss",
    "!**/*.gen.rc",
    "!installer/**",
    "!dist/**",
    "!build/**",
    "!dictionaries/**",
    "!**/node_modules/**"
  ],
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "editor.wordWrap": "on",
  "editor.formatOnSave": false,
  "clang-format.style": "file",
  "clang-format.fallbackStyle": "LLVM",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.maxTokenizationLineLength": 7500
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[cmake]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.eol": "\n"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[markdown]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on"
  },
  "[bat]": {
    "files.eol": "\r\n",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[innosetup]": {
    "files.eol": "\r\n",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[xml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[plaintext]": {
    "editor.wordWrap": "on"
  },
  "cmake.sourceDirectory": "D:/Projects/Dynamic-Island-for-Windows-Lux-main/app",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.onConfigChanged": "restart",
  "clangd.arguments": [
    "--header-insertion=never",
    "--background-index"
  ]
}
