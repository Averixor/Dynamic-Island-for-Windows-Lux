# Auto-detect text; normalize to LF in the repo except Windows script types below.
* text=auto eol=lf

# cmd.exe requires CRLF; LF-only .bat/.cmd eats the first char of each line (setlocal → etlocal).
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.exe binary
*.dll binary
*.pdb binary
